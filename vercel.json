{
  "crons": [
    {
      "path": "/api/quota-report",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/followup-emails",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "api/generate.ts": {
      "memory": 3009,
      "maxDuration": 300,
      "includeFiles": "{api/lib/skin/models/**,node_modules/@vladmandic/face-api/dist/face-api.esm.mjs,node_modules/@vladmandic/face-api/dist/face-api.esm.js,node_modules/@vladmandic/face-api/package.json}"
    },
    "api/face-descriptor.ts": {
      "memory": 3009,
      "maxDuration": 300,
      "includeFiles": "{api/lib/skin/models/**,node_modules/@vladmandic/face-api/dist/face-api.esm.mjs,node_modules/@vladmandic/face-api/dist/face-api.esm.js,node_modules/@vladmandic/face-api/package.json}"
    }
  },
  "rewrites": [
    { "source": "/healthcare", "destination": "/index.html" },
    { "source": "/teams", "destination": "/index.html" },
    { "source": "/headshot-generator-gallery", "destination": "/index.html" },
    { "source": "/how-it-works", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/faq/:slug", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ]
}
